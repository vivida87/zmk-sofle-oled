#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp GRAVE     &kp N1     &kp N2          &kp N3        &kp N4  &kp N5     &kp UP_ARROW     &kp N6     &kp N7         &kp N8     &kp N9      &kp N0    &kp BACKSPACE
&kp TAB       &kp Q      &kp W           &kp E         &kp R   &kp T      &kp DOWN_ARROW   &kp Y      &kp U          &kp I      &kp O       &kp P     &kp BSLH
&kp CAPSLOCK  &kp A      &kp S           &kp D         &kp F   &kp G      &kp LEFT_ARROW   &kp H      &kp J          &kp K      &kp L       &kp SEMI  &kp ENTER
&kp LSHFT     &kp Z      &kp X           &kp C         &kp V   &kp B      &kp RIGHT_ARROW  &kp N      &kp M          &kp COMMA  &kp DOT     &kp FSLH  &kp RSHIFT
&kp C_MUTE    &kp LCTRL  &kp LANGUAGE_1  &kp LEFT_ALT  &mo 1   &kp F13    &kp ENTER        &kp SPACE  &kp BACKSPACE  &kp ENTER  &kp DELETE  &mo 2
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "L0";
        };

        layer_1 {
            bindings = <
&kp ESCAPE        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &mmv MOVE_UP     &kp F6      &kp F7       &kp F8         &kp F9      &kp UNDERSCORE    &kp PLUS
&kp C_PREV        &trans  &trans  &trans  &trans  &trans    &mmv MOVE_DOWN   &mkp MB2    &kp HOME     &kp PAGE_UP    &kp END     &kp MINUS         &kp EQUAL
&kp C_PLAY_PAUSE  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT   &trans      &kp DELETE   &kp PAGE_DOWN  &kp INSERT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp C_NEXT        &trans  &trans  &trans  &trans  &trans    &mmv MOVE_RIGHT  &trans      &trans       &trans         &trans      &trans            &trans
&kp C_MUTE        &trans  &trans  &trans  &trans  &trans    &mkp LCLK        &kp LA(F4)  &kp LA(TAB)  &kp LG(LS(S))  &trans      &trans
            >;

            display-name = "L1";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_2 {
            bindings = <
&sys_reset   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3      &bt BT_SEL 4         &trans  &sys_reset   &trans  &trans  &trans  &trans  &trans
&bootloader  &out OUT_BLE  &out OUT_USB  &trans          &bt BT_CLR        &bt BT_CLR_ALL       &trans  &bootloader  &trans  &trans  &trans  &trans  &trans
&trans       &bl BL_ON     &bl BL_INC    &rgb_ug RGB_ON  &rgb_ug RGB_OFF   &rgb_ug RGB_EFF      &trans  &trans       &trans  &trans  &trans  &trans  &trans
&trans       &bl BL_OFF    &bl BL_DEC    &trans          &ext_power EP_ON  &ext_power EP_OFF    &trans  &trans       &trans  &trans  &trans  &trans  &trans
&trans       &trans        &trans        &trans          &trans            &trans               &trans  &trans       &trans  &trans  &trans  &trans
            >;

            display-name = "L2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
